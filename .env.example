# Server Configuration
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=super-secret-jwt-token-key-change-in-production-12345
JWT_EXPIRES_IN=7d

# Database
# If MONGODB_URI is provided, Mongoose connects to MongoDB.
# If omitted or unreachable, the server automatically uses the built-in embedded persistent JSON database.
MONGODB_URI=mongodb://localhost:27017/smart_todo_planner

# AI Studio injected variables
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
